# Kupi — copy to .env.local and fill in. Server-side only; never expose
# META_API_KEY to the client (no NEXT_PUBLIC_ prefix, ever).

# --- Meta AI (the ONLY AI provider in Kupi) ---
# Verified with the provided key at https://api.meta.ai/v1 (model list checked):
#   Chat / content generation: muse-wonder-1.0 (teacher), muse-spark-1.3 (classmates)
#   Image generation:          muse-image-1.0   (POST /v1/images/generations)
#   Speech-to-text:            muse-spark-1.3 with audio input (chat input_audio)
#   Text-to-speech:            no Meta TTS model exists on this account, so the
#                              teacher's voice uses the browser's built-in speech.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_TEACHER_MODEL=muse-wonder-1.0
META_CLASSMATE_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
# LLM_PROVIDER=meta (default) or mock (force offline fixtures in tests/dev)
LLM_PROVIDER=meta

# Speech: browser-native only (speechSynthesis / SpeechRecognition).
# TTS_PROVIDER=browser (default) or mock (tests). No third-party TTS.
TTS_PROVIDER=browser

# --- Curriculum graph (optional) ---
CURRICULUM_GRAPH_DRIVER=memory
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
