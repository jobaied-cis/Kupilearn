# Curriculum engine — copy to .env.local and fill in.
# Graph driver: memory (default, zero-infra) or neo4j (production).
CURRICULUM_GRAPH_DRIVER=memory
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# LLM provider: mock (default, deterministic) or http (BYO endpoint).
LLM_PROVIDER=mock
LLM_API_URL=
LLM_API_KEY=

# Optional: set to use embedding cosine instead of TF cosine for §3.2.
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=

# Classroom TTS provider: mock (default, deterministic URLs), http (BYO endpoint),
# or google (Google Cloud Text-to-Speech, needs GOOGLE_TTS_API_KEY).
# VAD/STT run in the client or media gateway; the server consumes text.
TTS_PROVIDER=mock
TTS_API_URL=
TTS_API_KEY=
# Google Cloud TTS: enable the Cloud Text-to-Speech API, create an API key
# (restrict it to that API), and paste it here.
GOOGLE_TTS_API_KEY=
