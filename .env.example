# Kupi — copy to .env.local and fill in. Server-side only; never expose
# META_API_KEY to the client (no NEXT_PUBLIC_ prefix, ever).

# --- Meta-only AI (the ONLY AI provider in Kupi) ---
# Verified Meta Llama API contract: POST {META_API_BASE_URL}/chat/completions
# with `Authorization: Bearer $META_API_KEY` (OpenAI-compatible, JSON mode).
# Default model IDs (Meta Llama API):
#   Teacher / complex reasoning: Llama-4-Maverick-17B-128E-Instruct-FP8
#   Classmates / light turns:    Llama-4-Scout-17B-16E-Instruct-FP8
# NOTE: Meta's current hosted catalog at api.meta.ai lists Muse models, not
# Llama. If your key is for api.meta.ai, set META_API_BASE_URL=https://api.meta.ai/v1
# and set the two model IDs below to models your key can access.
# Leave META_API_KEY empty/placeholder to run the deterministic offline
# lesson engine (the UI shows an "offline lesson mode" banner).
META_API_KEY=
META_API_BASE_URL=https://api.llama.com/v1
META_TEACHER_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
META_CLASSMATE_MODEL=Llama-4-Scout-17B-16E-Instruct-FP8
# LLM_PROVIDER=meta (default) or mock (force offline fixtures in tests/dev)
LLM_PROVIDER=meta

# Speech: browser-native only (speechSynthesis / SpeechRecognition).
# TTS_PROVIDER=browser (default) or mock (tests). No third-party TTS.
TTS_PROVIDER=browser

# --- Curriculum graph (optional) ---
CURRICULUM_GRAPH_DRIVER=memory
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
